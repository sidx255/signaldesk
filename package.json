{
	"name": "signaldesk",
	"version": "1.0.0",
	"private": true,
	"description": "A stateful incident-response copilot built on Cloudflare Agents",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"types": "wrangler types env.d.ts",
		"format": "oxfmt --write .",
		"lint": "oxlint src/ test/",
		"check": "oxfmt --check . && oxlint src/ test/ && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/ai-chat": "0.9.3",
		"agents": "^0.17.4",
		"ai": "^6.0.197",
		"lucide-react": "^0.544.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"workers-ai-provider": "^3.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "^8.0.2",
		"@cloudflare/vite-plugin": "^1.46.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.113.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.17.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js-pure",
			"esbuild",
			"workerd"
		]
	}
}
